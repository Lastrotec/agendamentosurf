{
  "name": "outside-surf-school",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agendamento de aulas de surf da Outside Surf School — PWA (Cloudflare Workers + Supabase)",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx scripts/dev-server.ts",
    "build": "vite build",
    "push:keys": "node scripts/push-keys.mjs",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/migrate.ts --seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "qrcode-generator": "1.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251001.0",
    "@hono/node-server": "2.1.5",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.151.0"
  }
}
